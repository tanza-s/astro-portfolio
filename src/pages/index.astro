---
import { getCollection } from "astro:content";
// Component Imports
import CallToAction from "../components/CallToAction.astro";
// Page section components
import ContactCTA from "../components/ContactCTA.astro";
import Feed from "../components/Feed.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import Pill from "../components/Pill.astro";
import PortfolioPreview from "../components/PortfolioPreview.astro";
import Skills from "../components/Skills.astro";
// Layout import — provides basic page elements: <head>, <nav>, <footer> etc.
import BaseLayout from "../layouts/BaseLayout.astro";

// Content Fetching: List four most recent work projects
const projects = (await getCollection("work"))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

// Full Astro Component Syntax:
// https://docs.astro.build/basics/astro-components/
---

<BaseLayout>
  <div class="stack gap-20 lg:gap-48">
    <div class="wrapper stack gap-8 lg:gap-20">
      <header class="intro">
        <div class="intro__portraits">
          <img
            class="intro__portrait-graphite intro__portrait-graphite--left"
            alt="Tanza is a programmer"
            src="/assets/website_graphite_left.png"
          />
          <img
            class="intro__portrait-graphite intro__portrait-graphite--right"
            alt="Tanza is a painter as well"
            src="/assets/website_graphite_right.png"
          />
        </div>
        <h1 class="intro__name">Tanza J. Solis</h1>
        <div class="intro__content">
          <div class="intro__info">
            <p class="intro__tagline">
              building digital tools for creative minds
            </p>
            <div class="intro__roles">
              <Pill><Icon file="code-open.svg" size="1.5em" /> Developer</Pill>
              <Pill><Icon file="palette.svg" size="1.5em" /> Artist</Pill>
              <Pill><Icon file="sparkle-multi.svg" size="1.5em" /> Curator</Pill>
            </div>
          </div>
        </div>
      </header>

      <Skills />
    </div>

    <main class="wrapper stack gap-20 lg:gap-48">
      <section class="section--projects">
        <header class="section__header">
          <div class="section__header-content">

            <span class="section__header-decor">
              <Icon file="star1.svg" size="1.5em" />
            </span>
            <h1 class="section__header-title">FEATURED WORK</h1>
            <span class="section__header-decor">
              <Icon file="star2.svg" size="2em" />
            </span>
          </div>
        </header>

        <div class="section__gallery">
          <Feed>
            {
              projects.map((project) => (
                <li class="project-feed__item">
                  <PortfolioPreview project={project} />
                </li>
              ))
            }
          </Feed>
        </div>

        <div class="section__cta">
          <CallToAction href="/work/">
            See my work
            <Icon file="arrow3.svg" size="1.2em" />
          </CallToAction>
        </div>
      </section>
    </main>

    <ContactCTA />
  </div>
</BaseLayout>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .intro__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .intro__roles {
    display: none;
  }

  .intro__content img {
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: top;
    border: 2px solid var(--gray-700);
    box-shadow: none;
  }

  img.intro__portrait {
    aspect-ratio: unset;
    box-shadow: unset;
    max-width: 50%;
  }

  .intro__portraits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    width: 100%;
  }

  .intro__portrait-graphite--left{
    position: relative;
    left: 0;
    bottom: 0;
  }

  .intro__portrait-graphite--right{
    position: relative;
    right: 20px;
    bottom: -45px;
    width: 100%;
  }

  @media (min-width: 50em) {
    .intro__portraits {
      gap: 1.5rem;
    }

    .intro__portrait-graphite--left{
      left: 100px;
      bottom: 10px;
    }

    .intro__portrait-graphite--right{
      position: absolute;
      right: 100px;
      bottom: -25px;
      width: 55%;
    }
  }

  .intro__name {
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-5xl);
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 0.95;
    color: var(--gray-0);
  }

  @media (min-width: 50em) {
    .intro__content {
      padding-inline: 2.5rem;
      gap: 3.75rem;
    }

    .intro__roles {
      margin-top: 0.5rem;
      display: flex;
      gap: 0.5rem;
      justify-content: center;
    }

    .intro__content img {
      aspect-ratio: 3 / 4;
      border: 2px solid var(--gray-700);
      object-fit: cover;
    }

    .intro__name {
      letter-spacing: -0.035em;
      line-height: 0.9;
    }
  }

  /* Page Section Styles */

  .section--projects {
    display: grid;
    gap: 2rem;
  }

  .section__header {
    justify-self: center;
    width: 100%;
    border: 1px solid var(--gray-700);
    padding: 1.5rem;
    background-color: transparent;
    text-align: center;
  }

  :global(:root.theme-dark) .section__header {
    background-color: var(--black);
  }

  .section__header-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  .section__header-decor {
    font-size: var(--text-2xl);
    color: var(--gray-0);
    font-weight: 700;
  }

  .section__header-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--gray-0);
    margin: 0;
    letter-spacing: 0.05em;
  }

  @media (min-width: 50em) {
    .section--projects {
      grid-template-columns: 1fr;
      grid-template-areas: "header" "gallery" "cta";
      gap: 5rem;
    }

    .section__header {
      grid-area: header;
      padding: 2rem;
    }

    .section__header-title {
      font-size: var(--text-4xl);
    }

    .section__gallery {
      grid-area: gallery;
    }

    .section__cta {
      grid-area: cta;
    }
  }

  .intro__content {
    font-size: var(--text-lg);
    text-align: center;
  }

  .intro__tagline {
    max-width: 37ch;
    margin-inline: auto;
  }

  .intro__tagline {
    margin-bottom: 2rem;
  }

  @media (min-width: 50em) {
    .intro__content {
      font-size: var(--text-xl);
    }
  }
</style>
