---
interface Props {
	title: string;
	tagline?: string;
	align?: 'start' | 'center';
}

const { align = 'center', tagline, title } = Astro.props;
---

<div class:list={[`hero stack gap-4 ${align === 'start' ? 'hero--start' : ''}`]}>
	<div class="stack gap-2">
		<h1 class="hero__title">{title}</h1>
		{tagline && <p class="hero__tagline">{tagline}</p>}
	</div>
	<slot />
</div>

<style>
	.hero {
		font-size: var(--text-lg);
		text-align: center;
	}

	.hero__title,
	.hero__tagline {
		max-width: 37ch;
		margin-inline: auto;
	}

	.hero__title {
		font-size: var(--text-3xl);
		color: var(--gray-0);
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.02em;
		text-transform: uppercase;
		line-height: 1.1;
	}

	@media (min-width: 50em) {
		.hero {
			font-size: var(--text-xl);
		}

		.hero--start {
			text-align: start;
		}

		.hero--start .hero__title,
		.hero--start .hero__tagline {
			margin-inline: unset;
		}

		.hero__title {
			font-size: var(--text-5xl);
			letter-spacing: -0.06em;
			line-height: 0.8;
		}
	}
</style>
