---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"work">;
}

const { data, id } = Astro.props.project;
---

<article class="card">
  <div class="card__image-wrapper">
    <img
      class="card__image"
      src={data.img}
      alt={data.img_alt || ""}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="card__content">
    <h3 class="card__title">{data.title}</h3>
    {data.description && <p class="card__description">{data.description}</p>}
    {
      data.tags && data.tags.length > 0 && (
        <div class="card__tags">
          {data.tags.map((tag) => (
            <span class="card__tag">{tag}</span>
          ))}
        </div>
      )
    }
    <a href={`/work/${id}`} class="card__button">Read Case Study</a>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-columns: 60% 40%;
    background-color: var(--gray-900);
    border: 2px solid var(--gray-700);
    overflow: hidden;
    box-shadow: none;
    transition: border-color var(--theme-transition);
    min-height: 18rem;
  }

  .card:hover {
    box-shadow: var(--shadow-md);
  }

  .card__image-wrapper {
    position: relative;
    overflow: hidden;
    background: var(--gray-800);
  }

  .card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--theme-transition);
	filter: saturate(0);
  }

  .card:hover .card__image {
    transform: scale(1.05);
	filter: none;
  }

  .card:hover .card__image-wrapper::after {
    opacity: 0;
  }

  .card__image-wrapper::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--accent-regular);
    mix-blend-mode: multiply;
    opacity: 1;
    pointer-events: none;
  }
  .card__content {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem;
    color: var(--gray-0);
  }

  .card__title {
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--gray-0);
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .card__caption {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent-dark);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
  }

  .card__description {
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--gray-200);
    margin: 0 0 1.5rem 0;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .card__tag {
    font-size: var(--text-sm);
    color: var(--gray-300);
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--gray-600);
    background-color: transparent;
  }

  .card__button {
    align-self: flex-start;
    padding: 0.75rem 1.5rem;
    background-color: var(--accent-regular);
    color: var(--accent-text-over);
    border: 2px solid var(--accent-regular);
    font-weight: 600;
    font-size: var(--text-base);
    cursor: pointer;
    text-decoration: none;
    transition: all var(--theme-transition);
  }

  .card__button:hover,
  .card__button:focus {
    background-color: var(--accent-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(234, 77, 17, 0.3);
  }

  :global(:root.theme-dark) .card__button {
    background-color: #ea4d11;
  }

  :global(:root.theme-dark) .card__button:hover,
  :global(:root.theme-dark) .card__button:focus {
    background-color: #f55a1f;
  }

  :global(:root.theme-dark) .card {
    background-color: var(--black);
  }

  @media (max-width: 50em) {
    .card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .card__image-wrapper {
      min-height: 250px;
    }

    .card__content {
      padding: 1.5rem;
    }

    .card__title {
      font-size: var(--text-xl);
    }
  }

  @media (min-width: 50em) {
    .card {
      min-height: 22rem;
    }

    .card__content {
      padding: 2.5rem;
    }
  }
</style>
